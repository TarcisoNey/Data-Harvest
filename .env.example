# =====================================================================
# Data Harvest - configuração local
# Copie este arquivo para .env e preencha POSTGRES_PASSWORD e GEMINI_API_KEY.
# O .env não vai para o git.
#
# Os comandos abaixo são para copiar e colar UM POR LINHA, sem o "# "
# do começo. Rode tudo na pasta do projeto (Data-Harvest).
# O Docker Desktop precisa estar aberto antes de subir o banco.
# =====================================================================
#
# ---------------- macOS e Linux (Terminal) ----------------
#
# Uma vez só:
# python3 -m venv .venv
# source .venv/bin/activate
# pip install -r requirements-dev.txt
# cp .env.example .env
# open -e .env
#   (no Linux, troque a linha acima por: nano .env)
#
# Carregar os dados (repita quando os dados mudarem):
# docker compose up -d db
# python src/downtime.py
# python src/etl.py
# python src/relatorios.py
# python src/rag_ingest.py
#
# Usar:
# python -m streamlit run dashboard/app.py
# python -m src.agente -v "Qual máquina falha mais?"
# python -m pytest -v
#
# Em todo terminal novo, antes dos comandos:
# cd Data-Harvest
# source .venv/bin/activate
#
# ---------------- Windows (PowerShell) ----------------
#
# Uma vez só:
# python -m venv .venv
# Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned
# .venv\Scripts\Activate.ps1
# pip install -r requirements-dev.txt
# copy .env.example .env
# notepad .env
#
# Carregar os dados (repita quando os dados mudarem):
# docker compose up -d db
# python src\downtime.py
# python src\etl.py
# python src\relatorios.py
# python src\rag_ingest.py
#
# Usar:
# python -m streamlit run dashboard\app.py
# python -m src.agente -v "Qual máquina falha mais?"
# python -m pytest -v
#
# Em todo terminal novo, antes dos comandos:
# cd Data-Harvest
# Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned
# .venv\Scripts\Activate.ps1
#
# ---------------- Problemas comuns ----------------
#
# "Não foi possível conectar ao PostgreSQL": abra o Docker Desktop e rode
#   docker compose up -d db   (confira com: docker compose ps)
# Porta 5432 ocupada por outro Postgres: troque DB_PORT=5433 abaixo e
#   rode de novo: docker compose up -d db
# Desligar o banco: docker compose down   (com -v no fim apaga os dados)
# =====================================================================

# --- PostgreSQL (banco do projeto) ---
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=sua_senha_segura
POSTGRES_DB=data_harvest_db
DB_HOST=localhost
DB_PORT=5432
# Os testes usam um banco separado no mesmo servidor (criado sozinho):
# TEST_POSTGRES_DB=data_harvest_test

# --- Agente RAG (src/agente) ---
# Gemini (padrão): chave do Google AI Studio - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# Modelo reserva, usado quando o principal continua dando 503/429:
# LLM_MODEL_RESERVA=gemini-3.6-flash
# Raciocínio: o Flash-Lite já usa o mínimo (mais rápido). Para mais
# raciocínio (mais lento): low, medium ou high.
# LLM_REASONING_EFFORT=low
# Para usar OpenAI no lugar do Gemini, deixe GEMINI_API_KEY vazia e preencha:
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# Para modelo local com Ollama, descomente:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5
# CHROMA_PATH=chroma_db
# CHROMA_COLLECTION=manuais_rag
# EMBEDDING_MODEL_DIR=   # pasta com model_quantized.onnx e tokenizer.json (opcional, uso offline)
