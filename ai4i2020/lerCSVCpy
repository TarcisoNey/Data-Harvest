"""ETL da Sprint 2: carrega os CSVs limpos no SQLite oficial.

Executar na raiz do Data-Harvest:
    python ai4i2020/lerCSVCpy

Este arquivo é o único código que precisa ser alterado.
Os CSVs e o schema SQL existentes são apenas lidos, não modificados.
"""
import argparse
import sqlite3
from pathlib import Path

import pandas as pd

RAIZ = Path(__file__).resolve().parents[1]
CSV_AI4I = RAIZ / "data/processed/ai4i2020/clean_ai4i.csv"
CSV_AI4I_BRUTO = RAIZ / "data/raw/ai4i2020/ai4i2020.csv"
CSV_DOWNTIME = RAIZ / "data/processed/downtime/clean_downtime.csv"
SCHEMA = RAIZ / "sql/schema_sqlite.sql"
BANCO = RAIZ / "data/sprint2_etl.db"

TABELAS_OFICIAIS = {
    "product_types", "failure_modes", "process_readings",
    "reading_failure_modes", "assembly_lines", "machines",
    "machine_downtime_logs",
}
MODOS = ["twf", "hdf", "pwf", "osf", "rnf"]
COLUNAS_LEITURA = [
    "udi", "product_id", "product_type_code", "air_temperature",
    "process_temperature", "rotational_speed", "torque", "tool_wear",
    "machine_failure",
]
SENSORES_DOWNTIME = [
    "hydraulic_pressure", "coolant_pressure", "air_system_pressure",
    "coolant_temperature", "hydraulic_oil_temperature",
    "spindle_bearing_temperature", "spindle_vibration", "tool_vibration",
    "spindle_speed", "voltage", "torque", "cutting",
]
COLUNAS_LOG = ["machine_id", "date", *SENSORES_DOWNTIME, "downtime_status"]


def ler_csv(caminho):
    if not caminho.is_file():
        raise FileNotFoundError(f"Arquivo não encontrado: {caminho}")
    df = pd.read_csv(caminho, encoding="utf-8-sig")
    if df.empty:
        raise ValueError(f"CSV vazio: {caminho}")
    print(f"Lido {caminho.name}: {len(df)} linhas")
    return df


def exigir_colunas(df, colunas, origem):
    faltantes = sorted(set(colunas) - set(df.columns))
    if faltantes:
        raise ValueError(f"{origem}: colunas ausentes: {faltantes}")


def preparar_ai4i(caminho):
    df = ler_csv(caminho)

    # O CSV limpo atual não contém UDI e Product ID. Recuperamos do
    # bruto SOMENTE após verificar as 12 colunas originais, linha a linha.
    # Assim, nenhum identificador de máquina/produto é inventado.
    if "udi" not in df.columns or "product_id" not in df.columns:
        bruto = ler_csv(CSV_AI4I_BRUTO).rename(columns={
            "UDI": "udi",
            "Product ID": "product_id",
            "Type": "type",
            "Air temperature [K]": "air_temperature",
            "Process temperature [K]": "process_temperature",
            "Rotational speed [rpm]": "rotational_speed",
            "Torque [Nm]": "torque",
            "Tool wear [min]": "tool_wear",
            "Machine failure": "machine_failure",
            "TWF": "twf",
            "HDF": "hdf",
            "PWF": "pwf",
            "OSF": "osf",
            "RNF": "rnf",
        })
        comparacao = [
            "type", "air_temperature", "process_temperature",
            "rotational_speed", "torque", "tool_wear",
            "machine_failure", *MODOS,
        ]
        exigir_colunas(df, comparacao, "AI4I limpo")
        exigir_colunas(bruto, ["udi", "product_id", *comparacao], "AI4I bruto")
       
        if len(bruto) != len(df):
            raise ValueError(
                "AI4I: CSV bruto e limpo têm números diferentes de linhas."
            )

        try:
            pd.testing.assert_frame_equal(
                df[comparacao].reset_index(drop=True),
                bruto[comparacao].reset_index(drop=True),
                check_dtype=False,
            )
        except AssertionError as erro:
            raise ValueError(
                "AI4I: CSV limpo não corresponde ao bruto. "
                "Não é seguro recuperar os identificadores."
            ) from erro

        df = df.copy()
        df["udi"] = bruto["udi"].to_numpy()
        df["product_id"] = bruto["product_id"].to_numpy()

        print("UDI e Product ID recuperados com sucesso.")

    obrigatorias = [
        "udi", "product_id", "type",
        *COLUNAS_LEITURA[3:], *MODOS
    ]
    exigir_colunas(df, obrigatorias, "AI4I")

    if df[obrigatorias].isna().any().any():
        raise ValueError("AI4I: existem valores vazios")

    inteiras = [
        "udi", "rotational_speed", "tool_wear",
        "machine_failure", *MODOS
    ]
    reais = [
        "air_temperature", "process_temperature", "torque"
    ]

    for coluna in inteiras + reais:
        df[coluna] = pd.to_numeric(df[coluna], errors="raise")

    for coluna in inteiras:
        if not (df[coluna] % 1 == 0).all():
            raise ValueError(f"AI4I: {coluna} deve ser inteiro")
        df[coluna] = df[coluna].astype(int)

    for coluna in ["machine_failure", *MODOS]:
        if not df[coluna].isin([0, 1]).all():
            raise ValueError(f"AI4I: {coluna} deve conter 0 ou 1")

    if not df["type"].isin(["L", "M", "H"]).all():
        raise ValueError("AI4I: tipo inválido")

    if df["udi"].duplicated().any():
        raise ValueError("AI4I: UDI duplicado")

    if df["product_id"].duplicated().any():
        raise ValueError("AI4I: Product ID duplicado")

    if (
        df["product_id"].astype(str).str[0] != df["type"]
    ).any():
        raise ValueError("AI4I: Product ID incompatível com type")

    df = df.rename(columns={"type": "product_type_code"})

    leituras = list(
        df.sort_values("udi")[COLUNAS_LEITURA].itertuples(
            index=False, name=None
        )
    )

    falhas = []
    for _, registro in df.iterrows():
        for modo in MODOS:
            if registro[modo] == 1:
                falhas.append((int(registro["udi"]), modo.upper()))

    falhas.sort()

    return leituras, falhas


def preparar_downtime(caminho):
    df = ler_csv(caminho)

    obrigatorias = [
        "machine_id", "assembly_line_no", "date",
        *SENSORES_DOWNTIME, "downtime"
    ]
    exigir_colunas(df, obrigatorias, "Downtime")

    if df[obrigatorias].isna().any().any():
        raise ValueError("Downtime: existem valores vazios")

    df["machine_id"] = df["machine_id"].astype(str).str.strip()
    df["assembly_line_no"] = (
        df["assembly_line_no"].astype(str).str.strip()
    )

    if (
        df["machine_id"].eq("").any()
        or df["assembly_line_no"].eq("").any()
    ):
        raise ValueError("Downtime: identificador vazio")

    df["date"] = pd.to_datetime(
        df["date"], errors="raise"
    ).dt.strftime("%Y-%m-%d")

    for coluna in SENSORES_DOWNTIME:
        df[coluna] = pd.to_numeric(df[coluna], errors="raise")

    pares = df[
        ["machine_id", "assembly_line_no"]
    ].drop_duplicates().sort_values("machine_id")

    if pares["machine_id"].duplicated().any():
        raise ValueError(
            "Downtime: mesma máquina vinculada a linhas diferentes"
        )

    df = df.rename(columns={"downtime": "downtime_status"})

    logs = list(
        df[COLUNAS_LOG].itertuples(index=False, name=None)
    )
    maquinas = list(pares.itertuples(index=False, name=None))

    return sorted(set(pares["assembly_line_no"])), maquinas, logs

def preparar_banco(conn, caminho_banco):
    conn.execute("PRAGMA foreign_keys = ON")
    existentes = {
        linha[0] for linha in conn.execute(
            "SELECT name FROM sqlite_master "
            "WHERE type='table' AND name NOT LIKE 'sqlite_%'"
        )
    }
    if not existentes:
        # O schema possui DROP TABLE: só é aplicado em banco vazio.
        if not SCHEMA.is_file():
            raise FileNotFoundError(f"Schema não encontrado: {SCHEMA}")
        conn.executescript(SCHEMA.read_text(encoding="utf-8"))
        conn.execute("PRAGMA foreign_keys = ON")
        print(f"Schema oficial criado em banco vazio: {caminho_banco}")
    elif existentes != TABELAS_OFICIAIS:
        raise ValueError(
            f"Banco já possui tabelas incompatíveis: {sorted(existentes)}. "
            "Não será apagado. Use um banco vazio ou o da carga anterior."
        )


def conferir_ou_inserir(conn, tabela, colunas, linhas, ordem):
    linhas = list(linhas)
    colunas_sql = ", ".join(colunas)
    existentes = conn.execute(
        f"SELECT {colunas_sql} FROM {tabela} ORDER BY {ordem}"
    ).fetchall()

    if existentes:
        if existentes != linhas:
            raise ValueError(
                f"{tabela}: dados existentes diferentes do CSV. "
                "A carga foi cancelada para evitar duplicação ou sobrescrita."
            )
        return 0

    marcadores = ", ".join("?" for _ in colunas)
    conn.executemany(
        f"INSERT INTO {tabela} ({colunas_sql}) VALUES ({marcadores})",
        linhas,
    )
    return len(linhas)


def carregar_csv(caminho_ai4i=CSV_AI4I, caminho_downtime=CSV_DOWNTIME, caminho_banco=BANCO):
    leituras, falhas = preparar_ai4i(Path(caminho_ai4i))
    linhas, maquinas, logs = preparar_downtime(Path(caminho_downtime))

    caminho_banco = Path(caminho_banco)
    caminho_banco.parent.mkdir(parents=True, exist_ok=True)
    with sqlite3.connect(caminho_banco) as conn:
        preparar_banco(conn, caminho_banco)
        with conn:
            novas_leituras = conferir_ou_inserir(
                conn, "process_readings", COLUNAS_LEITURA, leituras, "udi"
            )
            novas_falhas = conferir_ou_inserir(
                conn, "reading_failure_modes",
                ["reading_udi", "failure_mode_code"], falhas,
                "reading_udi, failure_mode_code",
            )

            for nome in linhas:
                conn.execute(
                    "INSERT OR IGNORE INTO assembly_lines (name) VALUES (?)",
                    (nome,),
                )
            ids_linhas = dict(conn.execute("SELECT name, id FROM assembly_lines"))
            for maquina, nome_linha in maquinas:
                conn.execute(
                    "INSERT OR IGNORE INTO machines (id, assembly_line_id) VALUES (?, ?)",
                    (maquina, ids_linhas[nome_linha]),
                )
            mapa_maquinas = dict(conn.execute(
                "SELECT machines.id, assembly_lines.name "
                "FROM machines JOIN assembly_lines "
                "ON machines.assembly_line_id = assembly_lines.id"
            ))
            if any(mapa_maquinas.get(m) != l for m, l in maquinas):
                raise ValueError("Downtime: máquina já existe vinculada a outra linha")

            novos_logs = conferir_ou_inserir(
                conn, "machine_downtime_logs", COLUNAS_LOG, logs, "id"
            )

            if conn.execute("PRAGMA foreign_key_check").fetchall():
                raise ValueError("SQLite: existem violações de chaves estrangeiras")
            if conn.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
                raise ValueError("SQLite: falha na verificação de integridade")

        print("\nCarga ETL concluída com sucesso!")
        for tabela in sorted(TABELAS_OFICIAIS):
            qtd = conn.execute(f"SELECT COUNT(*) FROM {tabela}").fetchone()[0]
            print(f"{tabela}: {qtd}")
        print(f"Novas leituras: {novas_leituras}")
        print(f"Novos modos de falha: {novas_falhas}")
        print(f"Novos logs de Downtime: {novos_logs}")
        print("Integridade do SQLite: OK")
        print(f"Banco: {caminho_banco}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ai4i", type=Path, default=CSV_AI4I)
    parser.add_argument("--downtime", type=Path, default=CSV_DOWNTIME)
    parser.add_argument("--db", type=Path, default=BANCO)
    args = parser.parse_args()
    carregar_csv(args.ai4i, args.downtime, args.db)


if __name__ == "__main__":
    main()
